# PostgreSQL Database Connection Configurations
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=querypilot

# LLM Gateway Settings
# Primary provider: Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative / Fallback provider: Groq API key (for fast fallback during spikes/rate limits)
GROQ_API_KEY=your_groq_api_key_here

# Optional model selection (defaults to gemini/gemini-2.5-flash)
PRIMARY_MODEL=gemini/gemini-2.5-flash
# Optional comma-separated fallback models (defaults to intelligent auto-detection based on keys)
# FALLBACK_MODELS=groq/llama-3.3-70b-versatile,gemini/gemini-2.0-flash,gemini/gemini-1.5-flash

# OpenTelemetry / LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=querypilot
